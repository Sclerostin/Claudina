//@version=6
// AMD Radar - where up to 12 stocks are in today's Accumulation -> Manipulation -> Distribution
//
// Same rules as AMD Day Trader, run on a list of stocks at once. Put it on any 5-minute chart
// (SPY works well) and read the table. One alert on this indicator sends a phone message when a
// stock finishes its manipulation (get ready) and when it gives a BUY.
// Automatic orders still come from AMD Day Trader's own alerts, one per stock.
// Educational tool, not financial advice.
indicator("AMD Radar", overlay = true)

string G1 = "Stocks"
int    nSym = input.int(12, "How many stocks", minval = 1, maxval = 12, group = G1)
string s01  = input.symbol("NASDAQ:NVDA", "1", group = G1)
string s02  = input.symbol("NASDAQ:TSLA", "2", group = G1)
string s03  = input.symbol("NASDAQ:AMD", "3", group = G1)
string s04  = input.symbol("NASDAQ:META", "4", group = G1)
string s05  = input.symbol("NASDAQ:AMZN", "5", group = G1)
string s06  = input.symbol("NASDAQ:AAPL", "6", group = G1)
string s07  = input.symbol("NASDAQ:MSFT", "7", group = G1)
string s08  = input.symbol("NASDAQ:GOOGL", "8", group = G1)
string s09  = input.symbol("NASDAQ:AVGO", "9", group = G1)
string s10  = input.symbol("NASDAQ:PLTR", "10", group = G1)
string s11  = input.symbol("NASDAQ:COIN", "11", group = G1)
string s12  = input.symbol("NASDAQ:MU", "12", group = G1)

string G2 = "Rules (keep the same as AMD Day Trader)"
int    orMin    = input.int(15, "Opening range (minutes)", options = [15, 30], group = G2)
string showWhat = input.string("A only", "Alert on which signals", options = ["A only", "A and B"], group = G2)
float  targetR  = input.float(2.0, "Target (x risk)", minval = 1.0, step = 0.5, group = G2)
float  capAtr   = input.float(2.0, "Widest stop (x ATR)", minval = 0.5, step = 0.5, group = G2)
string mktSym   = input.symbol("AMEX:SPY", "Market", group = G2)
float  rsiFear  = input.float(10, "Fear day: market RSI(2) at or below", minval = 1, maxval = 50, group = G2)
float  gapAtr   = input.float(1.0, "Big gap (x market daily ATR)", minval = 0.25, step = 0.25, group = G2)
bool   useMktVw = input.bool(true, "Only buy while the market is above its VWAP", group = G2)

string G3 = "Display"
string panelPos  = input.string("Top right", "Table position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G3)
string panelSize = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = G3)

color cBuy  = #26a69a
color cSell = #ef5350
color cBox  = #29b6f6
color cPd   = #ffca28
color cMute = #9e9e9e

px(float p) =>
    str.tostring(p, "#.##")

clock(int mins) =>
    int hh  = math.floor(mins / 60.0)
    int mm  = mins - hh * 60
    int h12 = hh % 12 == 0 ? 12 : hh % 12
    str.tostring(h12) + ":" + (mm < 10 ? "0" : "") + str.tostring(mm)

// AMD state of one stock, computed on that stock's own 5-minute candles.
// state: 0 closed, 1 accumulation, 2 waiting for manipulation, 3 manipulation done,
//        4 BUY given, 5 no setup today
// result: 0 none, 1 open, 2 target, 3 stop, 4 closed at 3:55
amd(int orLen, float cap, float tR) =>
    string NYz = "America/New_York"
    int  m     = hour(time, NYz) * 60 + minute(time, NYz)
    int  d     = year(time, NYz) * 10000 + month(time, NYz) * 100 + dayofmonth(time, NYz)
    bool rth   = m >= 570 and m < 960
    float atr  = ta.atr(14)
    var int   cur      = na
    var float prevLow  = na
    var float dayLow   = na
    var float orH      = na
    var float orL      = na
    var bool  swept    = false
    var float mLow     = na
    var bool  used     = false
    var bool  bought   = false
    var float ePx      = na
    var float sPx      = na
    var float tPx      = na
    var int   bTime    = na
    var int   result   = 0
    bool start = rth and (na(cur) or d != cur)
    if start
        prevLow := dayLow
        dayLow  := low
        cur     := d
        orH     := high
        orL     := low
        swept   := false
        mLow    := na
        used    := false
        bought  := false
        result  := 0
    else if rth
        dayLow := math.min(dayLow, low)
        if m < 570 + orLen
            orH := math.max(orH, high)
            orL := math.min(orL, low)
    bool  afterOR = rth and m >= 570 + orLen
    float line    = na(prevLow) ? orL : math.max(orL, prevLow)
    bool  sweep   = afterOR and m < 660 and not swept and not na(orL) and low < line
    if sweep
        swept := true
        mLow  := low
    else if swept and not used
        mLow := math.min(mLow, low)
    // a trade from earlier today: stop first if one candle touches both
    if bought and result == 1
        if low <= sPx
            result := 3
        else if high >= tPx
            result := 2
        else if m + 5 >= 955
            result := 4
    float rng  = high - low
    bool  trig = afterOR and m < 720 and swept and not used and close > open and rng > 0 and (close - low) >= 0.6 * rng and close > orH and close[1] <= orH
    float stp  = math.max(mLow, close - cap * atr) - 0.1 * atr
    bool  buy  = trig and close - stp >= 0.3 * atr and m + 5 < 955
    if trig
        used := true
    if buy
        bought := true
        ePx    := close
        sPx    := stp
        tPx    := close + tR * (close - stp)
        bTime  := m
        result := 1
    int state = not rth ? 0 : m < 570 + orLen ? 1 : bought ? 4 : used ? 5 : not swept and m < 660 ? 2 : not swept ? 5 : m < 720 ? 3 : 5
    [state, line, orH, mLow, sweep, buy, ePx, sPx, tPx, bTime, result]

// ----- The market's day -----
string mktId = ticker.modify(mktSym, session = session.regular)
[mRsi, mOpen, mPrevClose, mAtr] = request.security(mktId, "D", [ta.rsi(close, 2)[1], open, close[1], ta.sma(ta.tr(true), 14)[1]], lookahead = barmerge.lookahead_on)
bool   mAboveVwap = request.security(mktId, timeframe.period, close > ta.vwap(hlc3))
float  mGap  = mAtr > 0 ? (mOpen - mPrevClose) / mAtr : na
string grade = na(mGap) ? "B" : mGap >= gapAtr ? "X" : (mRsi <= rsiFear or mGap <= -gapAtr) ? "A" : "B"
bool   alertGrade = grade == "A" or (showWhat == "A and B" and grade == "B")
bool   mktOk = not useMktVw or mAboveVwap

// ----- One request per stock -----
rid(string s) =>
    ticker.modify(s, session = session.regular)

[st01, ln01, hi01, ml01, sw01, by01, ep01, sp01, tp01, bt01, rs01] = request.security(rid(s01), timeframe.period, amd(orMin, capAtr, targetR))
[st02, ln02, hi02, ml02, sw02, by02, ep02, sp02, tp02, bt02, rs02] = request.security(rid(s02), timeframe.period, amd(orMin, capAtr, targetR))
[st03, ln03, hi03, ml03, sw03, by03, ep03, sp03, tp03, bt03, rs03] = request.security(rid(s03), timeframe.period, amd(orMin, capAtr, targetR))
[st04, ln04, hi04, ml04, sw04, by04, ep04, sp04, tp04, bt04, rs04] = request.security(rid(s04), timeframe.period, amd(orMin, capAtr, targetR))
[st05, ln05, hi05, ml05, sw05, by05, ep05, sp05, tp05, bt05, rs05] = request.security(rid(s05), timeframe.period, amd(orMin, capAtr, targetR))
[st06, ln06, hi06, ml06, sw06, by06, ep06, sp06, tp06, bt06, rs06] = request.security(rid(s06), timeframe.period, amd(orMin, capAtr, targetR))
[st07, ln07, hi07, ml07, sw07, by07, ep07, sp07, tp07, bt07, rs07] = request.security(rid(s07), timeframe.period, amd(orMin, capAtr, targetR))
[st08, ln08, hi08, ml08, sw08, by08, ep08, sp08, tp08, bt08, rs08] = request.security(rid(s08), timeframe.period, amd(orMin, capAtr, targetR))
[st09, ln09, hi09, ml09, sw09, by09, ep09, sp09, tp09, bt09, rs09] = request.security(rid(s09), timeframe.period, amd(orMin, capAtr, targetR))
[st10, ln10, hi10, ml10, sw10, by10, ep10, sp10, tp10, bt10, rs10] = request.security(rid(s10), timeframe.period, amd(orMin, capAtr, targetR))
[st11, ln11, hi11, ml11, sw11, by11, ep11, sp11, tp11, bt11, rs11] = request.security(rid(s11), timeframe.period, amd(orMin, capAtr, targetR))
[st12, ln12, hi12, ml12, sw12, by12, ep12, sp12, tp12, bt12, rs12] = request.security(rid(s12), timeframe.period, amd(orMin, capAtr, targetR))

// ----- Table and alerts -----
posOf(string p) =>
    switch p
        "Top left"     => position.top_left
        "Bottom left"  => position.bottom_left
        "Bottom right" => position.bottom_right
        => position.top_right

string tSize = switch panelSize
    "Tiny"   => size.tiny
    "Normal" => size.normal
    => size.small

var table tbl = table.new(posOf(panelPos), 3, 14, bgcolor = color.new(chart.bg_color, 5), border_color = color.new(chart.fg_color, 85), border_width = 1)

cell(int c, int r, string t, color tc) =>
    table.cell(tbl, c, r, t, text_color = tc, text_size = tSize, text_halign = text.align_left)

nameOf(string s) =>
    int p = str.pos(s, ":")
    na(p) ? s : str.substring(s, p + 1)

// Phone message for one stock on this candle ("" when nothing new)
string NY    = "America/New_York"
int    today = year(time, NY) * 10000 + month(time, NY) * 100 + dayofmonth(time, NY)
var array<int> skipDay = array.new<int>(13, 0)

evt(int r, string s, float ln, float hi, bool sw, bool by, float ep, float sp, float tp) =>
    string nm  = nameOf(s)
    string msg = ""
    if sw
        msg := nm + " manipulation done (dip below " + px(ln) + "): BUY if a strong candle closes above " + px(hi) + " by 12:00"
    if by
        if mktOk
            msg := nm + " BUY " + px(ep) + " - stop " + px(sp) + " - target " + px(tp)
        else
            array.set(skipDay, r, today)
            msg := nm + " BUY skipped - market below VWAP"
    msg

array<string> msgs = array.new<string>()
array.push(msgs, evt(1, s01, ln01, hi01, sw01, by01, ep01, sp01, tp01))
if nSym >= 2
    array.push(msgs, evt(2, s02, ln02, hi02, sw02, by02, ep02, sp02, tp02))
if nSym >= 3
    array.push(msgs, evt(3, s03, ln03, hi03, sw03, by03, ep03, sp03, tp03))
if nSym >= 4
    array.push(msgs, evt(4, s04, ln04, hi04, sw04, by04, ep04, sp04, tp04))
if nSym >= 5
    array.push(msgs, evt(5, s05, ln05, hi05, sw05, by05, ep05, sp05, tp05))
if nSym >= 6
    array.push(msgs, evt(6, s06, ln06, hi06, sw06, by06, ep06, sp06, tp06))
if nSym >= 7
    array.push(msgs, evt(7, s07, ln07, hi07, sw07, by07, ep07, sp07, tp07))
if nSym >= 8
    array.push(msgs, evt(8, s08, ln08, hi08, sw08, by08, ep08, sp08, tp08))
if nSym >= 9
    array.push(msgs, evt(9, s09, ln09, hi09, sw09, by09, ep09, sp09, tp09))
if nSym >= 10
    array.push(msgs, evt(10, s10, ln10, hi10, sw10, by10, ep10, sp10, tp10))
if nSym >= 11
    array.push(msgs, evt(11, s11, ln11, hi11, sw11, by11, ep11, sp11, tp11))
if nSym >= 12
    array.push(msgs, evt(12, s12, ln12, hi12, sw12, by12, ep12, sp12, tp12))
string out = ""
for m in msgs
    if m != ""
        out := out + (out == "" ? "" : " | ") + m
if out != "" and alertGrade
    alert("AMD Radar (" + grade + " day): " + out, alert.freq_once_per_bar_close)

// One stock's row in the table
show(int r, string s, int st, float ln, float hi, float ep, float sp, float tp, int bt, int res) =>
    string ph  = ""
    string nx  = ""
    color  col = chart.fg_color
    if st == 0
        ph  := "-"
        nx  := "market closed"
        col := cMute
    else if st == 1
        ph  := "1 Accum"
        nx  := "box forming"
        col := cBox
    else if st == 2
        ph  := "2 Wait M"
        nx  := "dip < " + px(ln) + " by 11:00"
        col := cPd
    else if st == 3
        ph  := "3 M done"
        nx  := "BUY > " + px(hi) + " by 12:00"
        col := cBuy
    else if st == 4 and array.get(skipDay, r) == today
        ph  := "skipped"
        nx  := "market was below VWAP"
        col := cMute
    else if st == 4
        ph  := "BUY " + clock(bt)
        nx  := res == 2 ? "TARGET hit" : res == 3 ? "stopped" : res == 4 ? "closed 3:55" : px(ep) + " / stop " + px(sp) + " / tgt " + px(tp)
        col := res == 3 ? cSell : cBuy
    else
        ph  := "-"
        nx  := "no setup today"
        col := cMute
    cell(0, r, nameOf(s), chart.fg_color)
    cell(1, r, ph, col)
    cell(2, r, nx, col)

if barstate.islast
    string gTxt = grade == "A" ? "A fear day - signals live" : grade == "X" ? "X market gapped up - no longs" : "B normal day - paper only"
    color  gCol = grade == "A" ? cBuy : grade == "X" ? cSell : chart.fg_color
    cell(0, 0, "AMD Radar", chart.fg_color)
    cell(1, 0, "Day " + grade, gCol)
    cell(2, 0, gTxt + (useMktVw ? (mAboveVwap ? " - market > VWAP" : " - market < VWAP: wait") : ""), gCol)
    show(1, s01, st01, ln01, hi01, ep01, sp01, tp01, bt01, rs01)
    if nSym >= 2
        show(2, s02, st02, ln02, hi02, ep02, sp02, tp02, bt02, rs02)
    if nSym >= 3
        show(3, s03, st03, ln03, hi03, ep03, sp03, tp03, bt03, rs03)
    if nSym >= 4
        show(4, s04, st04, ln04, hi04, ep04, sp04, tp04, bt04, rs04)
    if nSym >= 5
        show(5, s05, st05, ln05, hi05, ep05, sp05, tp05, bt05, rs05)
    if nSym >= 6
        show(6, s06, st06, ln06, hi06, ep06, sp06, tp06, bt06, rs06)
    if nSym >= 7
        show(7, s07, st07, ln07, hi07, ep07, sp07, tp07, bt07, rs07)
    if nSym >= 8
        show(8, s08, st08, ln08, hi08, ep08, sp08, tp08, bt08, rs08)
    if nSym >= 9
        show(9, s09, st09, ln09, hi09, ep09, sp09, tp09, bt09, rs09)
    if nSym >= 10
        show(10, s10, st10, ln10, hi10, ep10, sp10, tp10, bt10, rs10)
    if nSym >= 11
        show(11, s11, st11, ln11, hi11, ep11, sp11, tp11, bt11, rs11)
    if nSym >= 12
        show(12, s12, st12, ln12, hi12, ep12, sp12, tp12, bt12, rs12)
    cell(0, 13, "Order", cMute)
    cell(1, 13, "1 > 2 > 3 > BUY", cMute)
    cell(2, 13, "box, dip under it, strong close above it", cMute)
