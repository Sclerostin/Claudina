//@version=6
// DT Core 3 - opening range breakout with automatic BUY / SELL, stop, target and exit
//
// What it does for you (Crabel 1990 opening range breakout, as taught by Aziz 2015):
//   1. Waits for the opening range: the high and low of the first minutes after the open.
//      Auto picks 5, 15 or 30 minutes from your chart timeframe.
//   2. BUY when a candle closes above the range, above VWAP, on strong volume.
//      SELL (short) when a candle closes below the range, below VWAP, on strong volume.
//   3. Stop at the middle of the range. Target at 2x the risk.
//   4. Exit at the stop, the target, or 5 minutes before the close.
//   At most one BUY and one SELL per day, and none after the cutoff.
//
// This is a strategy: TradingView simulates every trade (see Strategy Tester), and
// alerts on order fills can send each order to a broker through a webhook.
// Educational tool. Not financial advice.
strategy("DT Core", overlay = true, initial_capital = 25000, margin_long = 25, margin_short = 25, process_orders_on_close = true, pyramiding = 0, slippage = 1, max_labels_count = 500)

// ----- Inputs -----
string G1 = "Signals"
string orChoice   = input.string("Auto", "Opening range length", options = ["Auto", "5 minutes", "15 minutes", "30 minutes", "60 minutes"], group = G1, tooltip = "How long to wait after the open before looking for a breakout. Auto: 5 min on a 1-minute chart, 15 min on 2 to 5 minute charts, 30 min on 10 to 15 minute charts.")
string openChoice = input.string("Auto", "Market open", options = ["Auto", "Exchange open", "9:30 New York"], group = G1, tooltip = "Auto: the exchange opening bell for stocks, 9:30 New York for futures, crypto and forex.")
string cutChoice  = input.string("2 hours after open", "Stop new signals", options = ["1 hour after open", "2 hours after open", "4 hours after open", "Never"], group = G1, tooltip = "Breakouts work best early. Open trades still run to their stop, target or the close.")
string stopChoice = input.string("Middle of range", "Stop placement", options = ["Middle of range", "Other side of range"], group = G1)
float  targetR    = input.float(2.0, "Target (x risk)", minval = 0.5, step = 0.5, group = G1, tooltip = "2 means the target is twice as far from entry as the stop.")
bool   useVolF    = input.bool(true, "Only on strong volume (1.5x average)", group = G1)
bool   useVwapF   = input.bool(true, "Only on the right side of VWAP", group = G1)
bool   allowSell  = input.bool(true, "Take SELL (short) signals", group = G1)

string G2 = "Show on chart"
bool   showVwap  = input.bool(true, "VWAP (green = price above, red = below)", group = G2)
bool   showOR    = input.bool(true, "Opening range box", group = G2)
bool   showPD    = input.bool(true, "Prior day high and low", group = G2)
bool   showPM    = input.bool(true, "Pre-market high and low (needs ETH on)", group = G2)
bool   showLunch = input.bool(true, "Shade midday (2 to 4 hours after open)", group = G2)
bool   showTags  = input.bool(true, "Price tags at the right edge", group = G2)
bool   showPanel = input.bool(true, "Status panel", group = G2)
string panelPos  = input.string("Top right", "Panel position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G2)
string panelSize = input.string("Small", "Panel text size", options = ["Tiny", "Small", "Normal"], group = G2)

string G3 = "Risk"
float acct    = input.float(25000, "Account size ($)", minval = 0, group = G3)
float riskPct = input.float(0.5, "Risk per trade (%)", minval = 0.05, maxval = 5, step = 0.05, group = G3, tooltip = "What you lose if the stop is hit. 0.5 to 1% is standard (Tharp, Elder).")

color cBuy  = #26a69a
color cSell = #ef5350
color cVwap = #f5a623
color cOR   = #29b6f6
color cPD   = #ffca28
color cPM   = #b0bec5

// ----- Timing: everything is measured from the market open -----
bool  intra = timeframe.isintraday
float tfMin = timeframe.in_seconds() / 60.0
int orPick = switch orChoice
    "5 minutes"  => 5
    "15 minutes" => 15
    "30 minutes" => 30
    "60 minutes" => 60
    => tfMin <= 1 ? 5 : tfMin <= 5 ? 15 : tfMin <= 15 ? 30 : 60
int orMin = math.max(orPick, math.ceil(tfMin))
int cutMin = switch cutChoice
    "1 hour after open"  => 60
    "4 hours after open" => 240
    "Never"              => 100000
    => 120
int MS_MIN = 60000

bool   nyTypes = syminfo.type == "futures" or syminfo.type == "crypto" or syminfo.type == "forex" or syminfo.type == "cfd"
bool   useNY   = openChoice == "9:30 New York" or (openChoice == "Auto" and nyTypes)
string showTz  = useNY ? "America/New_York" : syminfo.timezone

bool newDay = timeframe.change("D")
int  nyY    = year(time, "America/New_York")
int  nyM    = month(time, "America/New_York")
int  nyD    = dayofmonth(time, "America/New_York")
int  t930   = timestamp("America/New_York", nyY, nyM, nyD, 9, 30, 0)

var int openT = na
if newDay
    openT := na
if na(openT)
    if useNY
        if time >= t930 and time < t930 + 390 * MS_MIN
            openT := time
    else if session.isfirstbar_regular
        openT := time

bool hasOpen   = not na(openT)
int  orEndT    = hasOpen ? openT + orMin * MS_MIN : na
int  cutT      = hasOpen ? openT + cutMin * MS_MIN : na
bool isOpenBar = hasOpen and time == openT
bool inOR      = hasOpen and time < orEndT
bool beforeCut = hasOpen and time < cutT
bool inLunch   = hasOpen and time >= openT + 120 * MS_MIN and time < openT + 240 * MS_MIN
bool eodBar    = hasOpen and time_close >= openT + 385 * MS_MIN

// ----- Opening range -----
var float orH = na
var float orL = na
if newDay
    orH := na
    orL := na
if inOR
    orH := na(orH) ? high : math.max(orH, high)
    orL := na(orL) ? low : math.min(orL, low)
bool  orReady = hasOpen and time >= orEndT and not na(orH)
float orMid   = (orH + orL) / 2

// ----- Pre-market (stocks, ETH on) or overnight (futures, crypto) high and low -----
var float preH = na
var float preL = na
if newDay
    preH := na
    preL := na
if not hasOpen
    preH := na(preH) ? high : math.max(preH, high)
    preL := na(preL) ? low : math.min(preL, low)
bool   stockLike = syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "dr"
string preTag    = stockLike ? "PM" : "ON"

// ----- Prior day high and low (no repaint) -----
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)

// ----- VWAP from the open (pre-open bars get their own) -----
float vol = nz(volume)
var float sPV = 0.0
var float sV  = 0.0
bool vwapReset = newDay or isOpenBar
if vwapReset
    sPV := 0.0
    sV  := 0.0
sPV += hlc3 * vol
sV  += vol
float vwapVal = sV > 0 ? sPV / sV : na

float volAvg = ta.sma(vol, 20)
float totVol = ta.cum(vol)
bool  volOK  = not useVolF or na(volAvg) or volAvg == 0 or vol >= 1.5 * volAvg

// ----- Volume versus normal for this time of day (last 10 sessions) -----
type VolHist
    array<float> vals

var map<int, VolHist> volByTime = map.new<int, VolHist>()
var float cumVol = 0.0
if newDay
    cumVol := 0.0
cumVol += vol
bool  rvolOn = intra and timeframe.in_seconds() >= 60
int   todKey = hour * 60 + minute
float avgCum = na
if rvolOn and map.contains(volByTime, todKey)
    VolHist h = map.get(volByTime, todKey)
    if array.size(h.vals) > 0
        avgCum := array.avg(h.vals)
float rvol = not na(avgCum) and avgCum > 0 ? cumVol / avgCum : na
if rvolOn and barstate.isconfirmed
    if not map.contains(volByTime, todKey)
        map.put(volByTime, todKey, VolHist.new(array.new<float>()))
    VolHist hh = map.get(volByTime, todKey)
    array.push(hh.vals, cumVol)
    if array.size(hh.vals) > 10
        array.shift(hh.vals)

// ----- Helpers -----
float  riskUsd = acct * riskPct / 100
float  pv      = syminfo.pointvalue
bool   fracQty = syminfo.type == "crypto" or syminfo.type == "forex"
string unit    = syminfo.type == "futures" ? " contracts" : fracQty ? " units" : " shares"

px(float p) =>
    str.tostring(p, format.mintick)

// Size so the stop loses your risk amount, capped at 4x day-trading buying power
qtyFor(float risk) =>
    float raw = risk > 0 ? riskUsd / (risk * pv) : na
    float cap = close > 0 ? acct * 4 / (close * pv) : na
    float q   = na(cap) ? raw : math.min(raw, cap)
    fracQty ? q : math.max(1, math.floor(q))

qtyStr(float q) =>
    na(q) ? "-" : fracQty ? str.tostring(q, "0.####") : str.tostring(q, "0")

clock(int t) =>
    int hh24 = hour(t, showTz)
    int mm   = minute(t, showTz)
    int h12  = hh24 % 12 == 0 ? 12 : hh24 % 12
    str.tostring(h12) + ":" + (mm < 10 ? "0" : "") + str.tostring(mm) + (hh24 < 12 ? " AM" : " PM")

// Webhook messages in the common TradersPost-style format
jsonEntry(string act, float q, float tgt, float stp) =>
    '{"ticker":"' + syminfo.ticker + '","action":"' + act + '","quantity":' + qtyStr(q) + ',"takeProfit":{"limitPrice":' + px(tgt) + '},"stopLoss":{"type":"stop","stopPrice":' + px(stp) + '}}'

jsonExit() =>
    '{"ticker":"' + syminfo.ticker + '","action":"exit"}'

// ----- Trade engine -----
bool xUp = ta.crossover(close, orH)
bool xDn = ta.crossunder(close, orL)

var bool   buyUsed    = false
var bool   sellUsed   = false
var int    dirNow     = 0
var float  entryPx    = na
var float  stopPx     = na
var float  tgtPx      = na
var float  riskPx     = na
var float  qtyNow     = na
var int    seenClosed = 0
var int    nDays      = 0
var float  sumR       = 0.0
var string lastResult = ""

if newDay
    buyUsed  := false
    sellUsed := false
    nDays    += 1

string msg       = ""
bool   exitedNow = false

// A trade closed since the last bar: label it and keep score
if strategy.closedtrades > seenClosed
    int   k  = strategy.closedtrades - 1
    float ep = strategy.closedtrades.entry_price(k)
    float xp = strategy.closedtrades.exit_price(k)
    int   d  = strategy.closedtrades.size(k) > 0 ? 1 : -1
    float r  = riskPx > 0 ? (xp - ep) * d / riskPx : 0.0
    bool  hitT = d == 1 ? xp >= tgtPx - 3 * syminfo.mintick : xp <= tgtPx + 3 * syminfo.mintick
    bool  hitS = d == 1 ? xp <= stopPx + 3 * syminfo.mintick : xp >= stopPx - 3 * syminfo.mintick
    string head = hitT ? "TARGET" : hitS ? "STOP" : "EXIT"
    string rTxt = (r >= 0 ? "+" : "") + str.tostring(r, "0.0") + "R"
    sumR += r
    label.new(strategy.closedtrades.exit_bar_index(k), 0.0, head + " " + rTxt, yloc = d == 1 ? yloc.abovebar : yloc.belowbar, style = d == 1 ? label.style_label_down : label.style_label_up, color = r > 0 ? cBuy : r < 0 ? cSell : color.gray, textcolor = color.white, size = size.small)
    lastResult := (d == 1 ? "BUY " : "SELL ") + head + " " + rTxt
    msg := "EXIT " + syminfo.ticker + " @ " + px(xp) + " - " + head + " " + rTxt
    seenClosed := strategy.closedtrades
    dirNow := 0
    exitedNow := true

// New entries, filled at the close of the signal candle
bool flat     = strategy.position_size == 0 and dirNow == 0
bool canTrade = intra and orReady and beforeCut and not eodBar and flat and not exitedNow
bool vwapUpOK = not useVwapF or na(vwapVal) or close > vwapVal
bool vwapDnOK = not useVwapF or na(vwapVal) or close < vwapVal
bool buySig   = canTrade and not buyUsed and xUp and volOK and vwapUpOK
bool sellSig  = canTrade and allowSell and not sellUsed and xDn and volOK and vwapDnOK

if buySig or sellSig
    int   d   = buySig ? 1 : -1
    float stp = stopChoice == "Middle of range" ? orMid : d == 1 ? orL : orH
    float rsk = math.abs(close - stp)
    float tgt = close + d * targetR * rsk
    float q   = qtyFor(rsk)
    dirNow  := d
    entryPx := close
    stopPx  := stp
    tgtPx   := tgt
    riskPx  := rsk
    qtyNow  := q
    if buySig
        buyUsed := true
        strategy.entry("BUY", strategy.long, qty = q, alert_message = jsonEntry("buy", q, tgt, stp))
        strategy.exit("BUY exit", from_entry = "BUY", stop = stp, limit = tgt, alert_message = jsonExit())
    else
        sellUsed := true
        strategy.entry("SELL", strategy.short, qty = q, alert_message = jsonEntry("sell", q, tgt, stp))
        strategy.exit("SELL exit", from_entry = "SELL", stop = stp, limit = tgt, alert_message = jsonExit())
    label.new(bar_index, 0.0, d == 1 ? "BUY" : "SELL", yloc = d == 1 ? yloc.belowbar : yloc.abovebar, style = d == 1 ? label.style_label_up : label.style_label_down, color = d == 1 ? cBuy : cSell, textcolor = color.white, size = size.normal)
    msg := (d == 1 ? "BUY " : "SELL ") + syminfo.ticker + " @ " + px(close) + " - stop " + px(stp) + " - target " + px(tgt) + " - " + qtyStr(q) + unit + " (risk $" + str.tostring(riskUsd, "#,##0") + ")"

// Flat before the close
if eodBar and strategy.position_size != 0
    strategy.close_all(comment = "CLOSE", alert_message = jsonExit())

// Phone notifications in plain words
if msg != ""
    alert(msg, alert.freq_once_per_bar_close)

// ----- Lines and shading -----
bool tradeOn = dirNow != 0 or exitedNow
plot(tradeOn ? stopPx : na, "Stop", cSell, 2, plot.style_linebr)
plot(tradeOn ? tgtPx : na, "Target", cBuy, 2, plot.style_linebr)
plot(tradeOn ? entryPx : na, "Entry", color.gray, 1, plot.style_linebr)

bool vwOn = intra and showVwap and not vwapReset
plot(vwOn ? vwapVal : na, "VWAP", close >= vwapVal ? cBuy : cSell, 2, plot.style_linebr)

pOH = plot(intra and showOR ? orH : na, "Opening range high", cOR, 2, plot.style_linebr)
pOL = plot(intra and showOR ? orL : na, "Opening range low", cOR, 2, plot.style_linebr)
fill(pOH, pOL, color.new(cOR, 88), "Opening range")

plot(intra and showPD and not newDay ? pdh : na, "Prior day high", cPD, 1, plot.style_linebr)
plot(intra and showPD and not newDay ? pdl : na, "Prior day low", cPD, 1, plot.style_linebr)
plot(intra and showPM ? preH : na, "Pre-market high", cPM, 1, plot.style_linebr)
plot(intra and showPM ? preL : na, "Pre-market low", cPM, 1, plot.style_linebr)

bgcolor(intra and showLunch and inLunch ? color.new(color.gray, 90) : na, title = "Midday")

// ----- Price tags at the right edge -----
addTag(array<label> arr, float y, string name, color col) =>
    if not na(y)
        array.push(arr, label.new(bar_index + 2, y, name + " " + str.tostring(y, format.mintick), style = label.style_label_left, color = color.new(col, 100), textcolor = col, size = size.small))

var array<label> tags = array.new<label>()
if barstate.islast
    for l in tags
        label.delete(l)
    array.clear(tags)
    if intra and showTags
        if showVwap
            addTag(tags, vwapVal, "VWAP", cVwap)
        if showOR and orReady
            addTag(tags, orH, "Range high", cOR)
            addTag(tags, orL, "Range low", cOR)
        if showPD
            addTag(tags, pdh, "Prior high", cPD)
            addTag(tags, pdl, "Prior low", cPD)
        if showPM
            addTag(tags, preH, preTag + " high", cPM)
            addTag(tags, preL, preTag + " low", cPM)

// ----- Status panel -----
posOf(string p) =>
    switch p
        "Top left"     => position.top_left
        "Bottom left"  => position.bottom_left
        "Bottom right" => position.bottom_right
        => position.top_right

string tSize = switch panelSize
    "Tiny"   => size.tiny
    "Normal" => size.normal
    => size.small

var table panel = table.new(posOf(panelPos), 2, 7, bgcolor = color.new(chart.bg_color, 6), border_color = color.new(chart.fg_color, 85), border_width = 1)

row(int r, string k, string v, color vc) =>
    table.cell(panel, 0, r, k, text_color = color.new(chart.fg_color, 35), text_size = tSize, text_halign = text.align_left)
    table.cell(panel, 1, r, v, text_color = vc, text_size = tSize, text_halign = text.align_left)

if barstate.islast and showPanel
    color fg = chart.fg_color
    row(0, "DT Core", syminfo.ticker + " - " + timeframe.period + (tfMin >= 1 ? " min" : ""), fg)
    if not intra
        row(1, "Status", "Switch to a 1 to 15 minute chart", cSell)
    else
        bool up = not na(vwapVal) and close > vwapVal
        bool dn = not na(vwapVal) and close < vwapVal
        row(1, "Trend", up ? "UP - price above VWAP" : dn ? "DOWN - price below VWAP" : "-", up ? cBuy : dn ? cSell : fg)

        string st   = ""
        string plan = ""
        color  stc  = fg
        bool doneToday = buyUsed and (sellUsed or not allowSell)
        if dirNow == 1
            st   := "IN A BUY TRADE"
            stc  := cBuy
            plan := "entry " + px(entryPx) + " - stop " + px(stopPx) + " - target " + px(tgtPx)
        else if dirNow == -1
            st   := "IN A SELL TRADE"
            stc  := cSell
            plan := "entry " + px(entryPx) + " - stop " + px(stopPx) + " - target " + px(tgtPx)
        else if not hasOpen
            st   := "Waiting for the open"
            plan := useNY ? "Opens 9:30 AM New York" : "Range starts at the opening bell"
        else if not orReady
            st   := "Opening range forming"
            stc  := cVwap
            plan := "Done at " + clock(orEndT) + " - so far " + px(orH) + " to " + px(orL)
        else if beforeCut and not doneToday
            st   := "Watching until " + clock(cutT)
            stc  := cVwap
            string buyPart  = buyUsed ? "" : "BUY above " + px(orH)
            string sellPart = allowSell and not sellUsed ? "SELL below " + px(orL) : ""
            plan := buyPart + (buyPart != "" and sellPart != "" ? " - " : "") + sellPart
        else
            st   := "No new signals today"
            plan := lastResult == "" ? "Next chance: next session's open" : "Last: " + lastResult
        row(2, "Status", st, stc)
        row(3, "Plan", plan, fg)

        float halfRange = stopChoice == "Middle of range" ? (orH - orL) / 2 : orH - orL
        float qtyIdea   = dirNow != 0 ? qtyNow : not na(halfRange) and halfRange > 0 ? qtyFor(halfRange) : na
        row(4, "Size", na(qtyIdea) ? "-" : (dirNow == 0 ? "about " : "") + qtyStr(qtyIdea) + unit + " - risk $" + str.tostring(riskUsd, "#,##0"), fg)

        string volTxt = na(rvol) ? (totVol == 0 ? "no volume data" : "building history") : str.tostring(rvol, "0.0") + "x normal" + (rvol >= 2 ? " - in play" : rvol < 1 ? " - quiet" : "")
        row(5, "Volume", volTxt, not na(rvol) and rvol >= 2 ? cBuy : fg)

        int    nT    = strategy.closedtrades
        string score = nT == 0 ? "no trades yet on this chart" : str.tostring(nDays) + " days - " + str.tostring(nT) + " trades - " + str.tostring(strategy.wintrades * 100.0 / nT, "0") + "% wins - " + (sumR >= 0 ? "+" : "") + str.tostring(sumR, "0.0") + "R"
        row(6, "Results", score, sumR > 0 ? cBuy : sumR < 0 ? cSell : fg)
