//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  DT Core 2 · simple BUY / SELL day-trading signals (uses ONE indicator slot)
//
//  The plan it follows for you (opening range breakout: Crabel 1990, Aziz 2015)
//   1. Wait for the opening range: the high and low of the first minutes after
//      the market opens. Auto picks 5, 15 or 30 minutes from your chart.
//   2. BUY when a candle CLOSES above the range, above VWAP, on strong volume.
//      SELL (short) is the mirror image below the range.
//   3. Stop at the middle of the range. Target = 2× what you risk.
//   4. Exit at the stop, the target, or 5 minutes before the close.
//      At most one BUY and one SELL per day; none after the cutoff.
//
//  Times are measured from the market open, so chart timezone and
//  extended-hours settings don't change the signals.
//  Educational tool. Not financial advice.
// ═══════════════════════════════════════════════════════════════════════════
indicator("DT Core", overlay = true, max_labels_count = 500, max_lines_count = 500)

// ───── Inputs ─────────────────────────────────────────────────────────────
string G1 = "Signals"
string orChoice   = input.string("Auto", "Opening range length", options = ["Auto", "5 minutes", "15 minutes", "30 minutes", "60 minutes"], group = G1, tooltip = "How long to wait after the open before looking for a breakout. Auto: 5 min on a 1-minute chart, 15 min on 2–5 minute charts, 30 min on 10–15 minute charts.")
string openChoice = input.string("Auto", "Market open", options = ["Auto", "Exchange open", "9:30 New York"], group = G1, tooltip = "Auto: the exchange's opening bell for stocks, 9:30 New York for futures, crypto and forex.")
string cutChoice  = input.string("2 hours after open", "Stop new signals", options = ["1 hour after open", "2 hours after open", "4 hours after open", "Never"], group = G1, tooltip = "Breakouts work best early. Open trades still run to their stop, target or the close.")
string stopChoice = input.string("Middle of range", "Stop placement", options = ["Middle of range", "Other side of range"], group = G1)
float  targetR    = input.float(2.0, "Target (× risk)", minval = 0.5, step = 0.5, group = G1, tooltip = "2 means the target is twice as far from entry as the stop.")
bool   useVolF    = input.bool(true, "Only on strong volume (1.5× average)", group = G1)
bool   useVwapF   = input.bool(true, "Only on the right side of VWAP", group = G1)
bool   allowSell  = input.bool(true, "Show SELL (short) signals", group = G1)

string G2 = "Show on chart"
bool   showVwap  = input.bool(true, "VWAP (green = price above, red = below)", group = G2)
bool   showBands = input.bool(false, "VWAP bands (±1σ and ±2σ)", group = G2)
bool   showEma   = input.bool(false, "9 and 20 EMA", group = G2)
bool   showOR    = input.bool(true, "Opening range box", group = G2)
bool   showPD    = input.bool(true, "Prior day high and low", group = G2)
bool   showPM    = input.bool(true, "Pre-market high and low", group = G2)
bool   showLunch = input.bool(true, "Shade midday (2–4 hours after open)", group = G2)
bool   showTags  = input.bool(true, "Price tags at the right edge", group = G2)
bool   showPanel = input.bool(true, "Status panel", group = G2)
string panelPos  = input.string("Top right", "Panel position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G2)
string panelSize = input.string("Small", "Panel text size", options = ["Tiny", "Small", "Normal"], group = G2)

string G3 = "Risk and alerts"
float  acct    = input.float(25000, "Account size ($)", minval = 0, group = G3)
float  riskPct = input.float(0.5, "Risk per trade (%)", minval = 0.05, maxval = 5, step = 0.05, group = G3, tooltip = "What you lose if the stop is hit. 0.5–1% is standard (Tharp, Elder).")
string msgFmt  = input.string("Plain text", "Alert message", options = ["Plain text", "JSON (webhook)"], group = G3, tooltip = "JSON is for automation services that read TradingView webhooks.")

color cBuy  = #26a69a
color cSell = #ef5350
color cVwap = #f5a623
color cOR   = #29b6f6
color cPD   = #ffca28
color cPM   = #b0bec5
color cEma1 = #42a5f5
color cEma2 = #ab47bc

// ───── Timing: everything is measured from the market open ────────────────
bool  intra = timeframe.isintraday
float tfMin = timeframe.in_seconds() / 60.0
int orPick = switch orChoice
    "5 minutes"  => 5
    "15 minutes" => 15
    "30 minutes" => 30
    "60 minutes" => 60
    => tfMin <= 1 ? 5 : tfMin <= 5 ? 15 : tfMin <= 15 ? 30 : 60
int orMin = math.max(orPick, math.ceil(tfMin))
int cutMin = switch cutChoice
    "1 hour after open"  => 60
    "4 hours after open" => 240
    "Never"              => 100000
    => 120
int MIN = 60000

bool   nyTypes = syminfo.type == "futures" or syminfo.type == "crypto" or syminfo.type == "forex" or syminfo.type == "cfd"
bool   useNY   = openChoice == "9:30 New York" or (openChoice == "Auto" and nyTypes)
string showTz  = useNY ? "America/New_York" : syminfo.timezone

bool newDay = timeframe.change("D")
int  t930   = timestamp("America/New_York", year(time, "America/New_York"), month(time, "America/New_York"), dayofmonth(time, "America/New_York"), 9, 30, 0)

var int openT = na
if newDay
    openT := na
if na(openT)
    if useNY
        if time >= t930 and time < t930 + 390 * MIN
            openT := time
    else if session.isfirstbar_regular
        openT := time

bool hasOpen = not na(openT)
int  orEndT  = hasOpen ? openT + orMin * MIN : na
int  cutT    = hasOpen ? openT + cutMin * MIN : na
bool isOpenBar = hasOpen and time == openT
bool inOR      = hasOpen and time < orEndT
bool beforeCut = hasOpen and time < cutT
bool inLunch   = hasOpen and time >= openT + 120 * MIN and time < openT + 240 * MIN
bool eodBar    = hasOpen and (time_close >= openT + 385 * MIN or (not useNY and session.islastbar_regular))

// ───── Opening range ──────────────────────────────────────────────────────
var float orH = na
var float orL = na
if newDay
    orH := na
    orL := na
if inOR
    orH := na(orH) ? high : math.max(orH, high)
    orL := na(orL) ? low : math.min(orL, low)
bool  orReady = hasOpen and time >= orEndT and not na(orH)
float orMid   = (orH + orL) / 2

// ───── Pre-market (stocks) or overnight (futures, crypto) high and low ────
// Stocks: pulled from extended-hours data even when the chart hides it.
pmLevels() =>
    var float h = na
    var float l = na
    if timeframe.change("D")
        h := na
        l := na
    if session.ispremarket
        h := na(h) ? high : math.max(h, high)
        l := na(l) ? low : math.min(l, low)
    [h, l]
[pmHx, pmLx] = request.security(ticker.modify(syminfo.tickerid, session.extended), timeframe.period, pmLevels())

var float onH = na
var float onL = na
if newDay
    onH := na
    onL := na
if not hasOpen
    onH := na(onH) ? high : math.max(onH, high)
    onL := na(onL) ? low : math.min(onL, low)

bool   stockLike = syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "dr"
float  preH   = stockLike ? pmHx : onH
float  preL   = stockLike ? pmLx : onL
string preTag = stockLike ? "PM" : "ON"

// ───── Prior day high and low (no repaint) ────────────────────────────────
[pdh, pdl] = request.security(ticker.modify(syminfo.tickerid, session.regular), "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)

// ───── VWAP from the open (pre-open bars get their own) ───────────────────
float vol = nz(volume)
var float sPV  = 0.0
var float sV   = 0.0
var float sPV2 = 0.0
bool vwapReset = newDay or isOpenBar
if vwapReset
    sPV  := 0.0
    sV   := 0.0
    sPV2 := 0.0
sPV  += hlc3 * vol
sV   += vol
sPV2 += hlc3 * hlc3 * vol
float vwapVal = sV > 0 ? sPV / sV : na
float sd      = sV > 0 ? math.sqrt(math.max(sPV2 / sV - vwapVal * vwapVal, 0.0)) : na

float ema9   = ta.ema(close, 9)
float ema20  = ta.ema(close, 20)
float volAvg = ta.sma(vol, 20)
float totVol = ta.cum(vol)
bool  volOK  = not useVolF or na(volAvg) or volAvg == 0 or vol >= 1.5 * volAvg

// ───── Volume versus normal for this time of day ──────────────────────────
type VolHist
    array<float> vals

var map<int, VolHist> volByTime = map.new<int, VolHist>()
var float cumVol = 0.0
if newDay
    cumVol := 0.0
cumVol += vol
bool  rvolOn = intra and timeframe.in_seconds() >= 60
int   todKey = hour * 60 + minute
float avgCum = na
if rvolOn and map.contains(volByTime, todKey)
    VolHist h = map.get(volByTime, todKey)
    if array.size(h.vals) > 0
        avgCum := array.avg(h.vals)
float rvol = not na(avgCum) and avgCum > 0 ? cumVol / avgCum : na
if rvolOn and barstate.isconfirmed
    if not map.contains(volByTime, todKey)
        map.put(volByTime, todKey, VolHist.new(array.new<float>()))
    VolHist hh = map.get(volByTime, todKey)
    array.push(hh.vals, cumVol)
    if array.size(hh.vals) > 10
        array.shift(hh.vals)

// ───── Trade engine: signals, stop, target, exits, scorecard ──────────────
float  riskUsd = acct * riskPct / 100
float  pv      = syminfo.pointvalue
bool   fracQty = syminfo.type == "crypto" or syminfo.type == "forex"
string unit    = syminfo.type == "futures" ? " contracts" : fracQty ? " units" : " shares"

qtyStr(float q) =>
    na(q) ? "—" : fracQty ? str.tostring(q, "0.####") : str.tostring(math.floor(q))
px(float p) =>
    str.tostring(p, format.mintick)

bool xUp = ta.crossover(close, orH)
bool xDn = ta.crossunder(close, orL)

var int   pos      = 0
var float entry    = na
var float stopPx   = na
var float tgtPx    = na
var float qty      = na
var int   entryIx  = na
var bool  buyUsed  = false
var bool  sellUsed = false
var line  lnStop   = na
var line  lnTgt    = na
var line  lnEntry  = na
var int   nTrades  = 0
var int   nWins    = 0
var float sumR     = 0.0
var int   nDays    = 0
var string lastResult = ""

if newDay
    buyUsed  := false
    sellUsed := false
    nDays    += 1

string alertMsg  = ""
bool   exitedNow = false

// Exits (checked on finished bars, never on the entry bar)
if barstate.isconfirmed and pos != 0 and bar_index > entryIx
    line.set_x2(lnStop, bar_index)
    line.set_x2(lnTgt, bar_index)
    line.set_x2(lnEntry, bar_index)
    float exitPx = na
    string why = ""
    if newDay
        exitPx := open
        why := "CLOSE"
    else if pos == 1 and low <= stopPx
        exitPx := math.min(open, stopPx)
        why := "STOP"
    else if pos == 1 and high >= tgtPx
        exitPx := math.max(open, tgtPx)
        why := "TARGET"
    else if pos == -1 and high >= stopPx
        exitPx := math.max(open, stopPx)
        why := "STOP"
    else if pos == -1 and low <= tgtPx
        exitPx := math.min(open, tgtPx)
        why := "TARGET"
    else if eodBar
        exitPx := close
        why := "CLOSE"
    if not na(exitPx)
        float risk = math.abs(entry - stopPx)
        float r = risk > 0 ? (exitPx - entry) * pos / risk : 0.0
        nTrades += 1
        nWins   += r > 0 ? 1 : 0
        sumR    += r
        string rTxt = (r >= 0 ? "+" : "") + str.tostring(r, "0.0") + "R"
        string head = why == "TARGET" ? "TARGET ✓" : why == "STOP" ? "STOP ✗" : "EXIT"
        label.new(bar_index, 0.0, head + "\n" + rTxt, yloc = pos == 1 ? yloc.abovebar : yloc.belowbar, style = pos == 1 ? label.style_label_down : label.style_label_up, color = r > 0 ? cBuy : r < 0 ? cSell : color.gray, textcolor = color.white, size = size.small)
        lastResult := (pos == 1 ? "BUY " : "SELL ") + head + " " + rTxt
        alertMsg := msgFmt == "Plain text" ? "EXIT " + syminfo.ticker + " @ " + px(exitPx) + " · " + head + " " + rTxt : '{"action":"exit","ticker":"' + syminfo.ticker + '","price":' + px(exitPx) + ',"reason":"' + str.lower(why) + '","r":' + str.tostring(r, "0.00") + '}'
        pos := 0
        exitedNow := true

// Entries (on the close of a finished bar)
bool canTrade = intra and barstate.isconfirmed and orReady and beforeCut and not eodBar and pos == 0 and not exitedNow
bool buySig   = canTrade and not buyUsed and xUp and volOK and (not useVwapF or na(vwapVal) or close > vwapVal)
bool sellSig  = canTrade and allowSell and not sellUsed and xDn and volOK and (not useVwapF or na(vwapVal) or close < vwapVal)

if buySig or sellSig
    pos     := buySig ? 1 : -1
    entry   := close
    stopPx  := stopChoice == "Middle of range" ? orMid : pos == 1 ? orL : orH
    float risk = math.abs(entry - stopPx)
    tgtPx   := entry + pos * targetR * risk
    qty     := risk > 0 ? riskUsd / (risk * pv) : na
    entryIx := bar_index
    if buySig
        buyUsed := true
    else
        sellUsed := true
    label.new(bar_index, 0.0, pos == 1 ? "BUY" : "SELL", yloc = pos == 1 ? yloc.belowbar : yloc.abovebar, style = pos == 1 ? label.style_label_up : label.style_label_down, color = pos == 1 ? cBuy : cSell, textcolor = color.white, size = size.normal)
    lnStop  := line.new(bar_index, stopPx, bar_index + 1, stopPx, color = cSell, width = 2)
    lnTgt   := line.new(bar_index, tgtPx, bar_index + 1, tgtPx, color = cBuy, width = 2)
    lnEntry := line.new(bar_index, entry, bar_index + 1, entry, color = color.gray, style = line.style_dotted)
    string act = pos == 1 ? "BUY" : "SELL"
    alertMsg := msgFmt == "Plain text" ? act + " " + syminfo.ticker + " @ " + px(entry) + " · stop " + px(stopPx) + " · target " + px(tgtPx) + " · " + qtyStr(qty) + unit + " (risk $" + str.tostring(riskUsd, "#,##0") + ")" : '{"action":"' + str.lower(act) + '","ticker":"' + syminfo.ticker + '","price":' + px(entry) + ',"stop":' + px(stopPx) + ',"target":' + px(tgtPx) + ',"qty":' + qtyStr(qty) + '}'

if alertMsg != ""
    alert(alertMsg, alert.freq_once_per_bar_close)

bool exitAlert = exitedNow
alertcondition(buySig, "BUY", "{{ticker}}: DT Core BUY at {{close}}")
alertcondition(sellSig, "SELL", "{{ticker}}: DT Core SELL at {{close}}")
alertcondition(exitAlert, "EXIT", "{{ticker}}: DT Core trade closed at {{close}}")

// ───── Lines and shading ──────────────────────────────────────────────────
bool vwOn = intra and showVwap and not vwapReset
plot(vwOn ? vwapVal : na, "VWAP", close >= vwapVal ? cBuy : cSell, 2, plot.style_linebr)
plot(vwOn and showBands ? vwapVal + sd : na, "VWAP +1σ", color.new(cVwap, 40), 1, plot.style_linebr)
plot(vwOn and showBands ? vwapVal - sd : na, "VWAP −1σ", color.new(cVwap, 40), 1, plot.style_linebr)
plot(vwOn and showBands ? vwapVal + 2 * sd : na, "VWAP +2σ", color.new(cVwap, 60), 1, plot.style_linebr)
plot(vwOn and showBands ? vwapVal - 2 * sd : na, "VWAP −2σ", color.new(cVwap, 60), 1, plot.style_linebr)
plot(showEma ? ema9 : na, "9 EMA", cEma1, 1)
plot(showEma ? ema20 : na, "20 EMA", cEma2, 1)

pOH = plot(intra and showOR ? orH : na, "Opening range high", cOR, 2, plot.style_linebr)
pOL = plot(intra and showOR ? orL : na, "Opening range low", cOR, 2, plot.style_linebr)
fill(pOH, pOL, color.new(cOR, 88), "Opening range")

plot(intra and showPD and not newDay ? pdh : na, "Prior day high", cPD, 1, plot.style_linebr)
plot(intra and showPD and not newDay ? pdl : na, "Prior day low", cPD, 1, plot.style_linebr)
plot(intra and showPM ? preH : na, "Pre-market high", cPM, 1, plot.style_linebr)
plot(intra and showPM ? preL : na, "Pre-market low", cPM, 1, plot.style_linebr)

bgcolor(intra and showLunch and inLunch ? color.new(color.gray, 90) : na, title = "Midday")

// ───── Price tags at the right edge ───────────────────────────────────────
addTag(array<label> arr, float y, string name, color col) =>
    if not na(y)
        array.push(arr, label.new(bar_index + 2, y, name + " " + str.tostring(y, format.mintick), style = label.style_label_left, color = color.new(col, 100), textcolor = col, size = size.small))

var array<label> tags = array.new<label>()
if barstate.islast
    for l in tags
        label.delete(l)
    array.clear(tags)
    if intra and showTags
        if showVwap
            addTag(tags, vwapVal, "VWAP", cVwap)
        if showOR and orReady
            addTag(tags, orH, "Range high", cOR)
            addTag(tags, orL, "Range low", cOR)
        if showPD
            addTag(tags, pdh, "Prior high", cPD)
            addTag(tags, pdl, "Prior low", cPD)
        if showPM
            addTag(tags, preH, preTag + " high", cPM)
            addTag(tags, preL, preTag + " low", cPM)

// ───── Status panel ───────────────────────────────────────────────────────
posOf(string p) =>
    switch p
        "Top left"     => position.top_left
        "Bottom left"  => position.bottom_left
        "Bottom right" => position.bottom_right
        => position.top_right
string tSize = switch panelSize
    "Tiny"   => size.tiny
    "Normal" => size.normal
    => size.small

var table panel = table.new(posOf(panelPos), 2, 7, bgcolor = color.new(chart.bg_color, 6), border_color = color.new(chart.fg_color, 85), border_width = 1)

row(int r, string k, string v, color vc) =>
    table.cell(panel, 0, r, k, text_color = color.new(chart.fg_color, 35), text_size = tSize, text_halign = text.align_left)
    table.cell(panel, 1, r, v, text_color = vc, text_size = tSize, text_halign = text.align_left)

clock(int t) =>
    str.format_time(t, "h:mm a", showTz)

if barstate.islast and showPanel
    color fg   = chart.fg_color
    color wait = cVwap
    row(0, "DT Core", syminfo.ticker + " · " + timeframe.period + (tfMin >= 1 ? " min" : ""), fg)
    if not intra
        row(1, "Status", "Switch to a 1–15 minute chart", cSell)
    else
        bool up = not na(vwapVal) and close > vwapVal
        bool dn = not na(vwapVal) and close < vwapVal
        row(1, "Trend", up ? "UP · price above VWAP" : dn ? "DOWN · price below VWAP" : "—", up ? cBuy : dn ? cSell : fg)

        string st = ""
        string plan = ""
        color stc = fg
        bool doneToday = buyUsed and (sellUsed or not allowSell)
        if pos == 1
            st := "IN A BUY TRADE"
            stc := cBuy
            plan := "entry " + px(entry) + " · stop " + px(stopPx) + " · target " + px(tgtPx)
        else if pos == -1
            st := "IN A SELL TRADE"
            stc := cSell
            plan := "entry " + px(entry) + " · stop " + px(stopPx) + " · target " + px(tgtPx)
        else if not hasOpen
            st := "Waiting for the open"
            plan := useNY ? "Opens 9:30 AM New York" : "Range starts at the opening bell"
        else if not orReady
            st := "Opening range forming"
            stc := wait
            plan := "Done at " + clock(orEndT) + " · so far " + px(orH) + " – " + px(orL)
        else if beforeCut and not doneToday
            st := "Watching until " + clock(cutT)
            stc := wait
            plan := (buyUsed ? "" : "BUY above " + px(orH)) + (not buyUsed and allowSell and not sellUsed ? " · " : "") + (allowSell and not sellUsed ? "SELL below " + px(orL) : "")
        else
            st := "No new signals today"
            plan := lastResult == "" ? "Next chance: tomorrow's open" : "Last: " + lastResult
        row(2, "Status", st, stc)
        row(3, "Plan", plan, fg)

        float sizeRisk = stopChoice == "Middle of range" ? (orH - orL) / 2 : orH - orL
        float qtyIdea  = pos != 0 ? qty : not na(sizeRisk) and sizeRisk > 0 ? riskUsd / (sizeRisk * pv) : na
        row(4, "Size", na(qtyIdea) ? "—" : (pos == 0 ? "≈ " : "") + qtyStr(qtyIdea) + unit + " · risk $" + str.tostring(riskUsd, "#,##0"), fg)

        row(5, "Volume", na(rvol) ? (totVol == 0 ? "no volume data" : "building history") : str.tostring(rvol, "0.0") + "× normal" + (rvol >= 2 ? " · in play" : rvol < 1 ? " · quiet" : ""), na(rvol) ? fg : rvol >= 2 ? cBuy : fg)

        string score = nTrades == 0 ? "no trades yet on this chart" : str.tostring(nDays) + " days · " + str.tostring(nTrades) + " trades · " + str.tostring(nWins * 100.0 / nTrades, "0") + "% wins · " + (sumR >= 0 ? "+" : "") + str.tostring(sumR, "0.0") + "R"
        row(6, "Results", score, sumR > 0 ? cBuy : sumR < 0 ? cSell : fg)
