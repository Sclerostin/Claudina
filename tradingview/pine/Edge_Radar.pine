//@version=6
// Edge Radar - today's expected R for up to 15 stocks, ranked, from the same evidence as Edge Reader
//
// Uses the daily part of Edge Reader's points (11 years of daily data) and each stock's own
// slippage cost at its current price and 5-minute ATR. It does not include the 5-minute points,
// so open the stock's chart with Edge Reader before acting. Put it on any 5-minute chart (SPY).
// Educational tool, not financial advice.
indicator("Edge Radar", overlay = true)

string G1 = "Stocks"
int    nSym = input.int(15, "How many stocks", minval = 1, maxval = 15, group = G1)
string s01  = input.symbol("NASDAQ:NVDA", "1", group = G1)
string s02  = input.symbol("NASDAQ:TSLA", "2", group = G1)
string s03  = input.symbol("NASDAQ:AMD", "3", group = G1)
string s04  = input.symbol("NASDAQ:META", "4", group = G1)
string s05  = input.symbol("NASDAQ:AMZN", "5", group = G1)
string s06  = input.symbol("NASDAQ:AAPL", "6", group = G1)
string s07  = input.symbol("NASDAQ:MSFT", "7", group = G1)
string s08  = input.symbol("NASDAQ:GOOGL", "8", group = G1)
string s09  = input.symbol("NASDAQ:AVGO", "9", group = G1)
string s10  = input.symbol("NASDAQ:PLTR", "10", group = G1)
string s11  = input.symbol("NASDAQ:COIN", "11", group = G1)
string s12  = input.symbol("NASDAQ:MU", "12", group = G1)
string s13  = input.symbol("NASDAQ:NFLX", "13", group = G1)
string s14  = input.symbol("NYSE:UBER", "14", group = G1)
string s15  = input.symbol("NYSE:JPM", "15", group = G1)

string G2 = "Same settings as Edge Reader"
float  minEdge   = input.float(0.05, "Edge needed for a signal (R)", step = 0.01, group = G2)
float  slipCents = input.float(0.01, "Slippage per fill ($ per share)", minval = 0, step = 0.005, group = G2)
float  slipPct   = input.float(0.01, "Slippage per fill (% of price)", minval = 0, step = 0.005, group = G2)
string mktSym    = input.symbol("AMEX:SPY", "Market", group = G2)

string G3 = "Display"
string panelPos  = input.string("Top right", "Table position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G3)
string panelSize = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = G3)

color cBuy  = #26a69a
color cSell = #ef5350
color cMute = #9e9e9e

// POINTS-BEGIN - written by research/points.py (refit.py); edit the numbers there, not here
